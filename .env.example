# Anthropic API Key
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LinkedIn OAuth Access Token
# Create an app at https://www.linkedin.com/developers/apps
# Required OAuth scopes: w_member_social, r_liteprofile
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# Your LinkedIn Person URN (format: urn:li:person:XXXXXXXX)
# Find it via: curl -H "Authorization: Bearer <token>" https://api.linkedin.com/v2/me
LINKEDIN_PERSON_URN=urn:li:person:your_person_id_here

# Optional: Organization URN if posting as a company page
# LINKEDIN_ORG_URN=urn:li:organization:your_org_id_here

# GTM Configuration
COMPANY_NAME=Your Company Name
PRODUCT_NAME=Your Product Name
TARGET_AUDIENCE=B2B SaaS decision makers
INDUSTRY=Technology
